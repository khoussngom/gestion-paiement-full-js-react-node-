// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TypeContrat {
  JOURNALIER
  SALAIRE_FIXE
  HONORAIRE
}

enum RoleUtilisateur {
  SUPER_ADMIN
  ADMIN_ENTREPRISE
  CAISSIER
  VIGILE
}

enum StatutDemande {
  EN_ATTENTE
  ACCEPTEE
  REJETEE
}

enum TypeCyclePaie {
  MENSUEL
  HEBDOMADAIRE
}

enum StatutCyclePaie {
  BROUILLON
  APPROUVE
  CLOTURE
}

enum StatutBulletinPaie {
  EN_ATTENTE
  PARTIEL
  PAYE
}

enum ModePaiement {
  ESPECES
  VIREMENT_BANCAIRE
  ORANGE_MONEY
  WAVE
  AUTRE
}

enum StatutPresence {
  PRESENT
  RETARD
  ABSENT
  CONGE
  MALADIE
}

enum TypePointage {
  ENTREE
  SORTIE
}

model Entreprise {
  id               String   @id @default(cuid())
  nom              String
  adresse          String?
  telephone        String?
  email            String?
  logo             String?
  couleurPrimaire  String?  @default("#4318FF")
  secteurActivite  String?
  devise           String   @default("FCFA")
  typePeriode      String   @default("MENSUEL")
  dateCreation     DateTime @default(now())
  dateModification DateTime @updatedAt
  actif            Boolean  @default(true)

  utilisateurs  Utilisateur[]
  employes      Employe[]
  cyclesPaie    CyclePaie[]
  bulletinsPaie BulletinPaie[]
  paiements     Paiement[]
  demandesAcces DemandeAcces[]
  pointages     Pointage[]
  autorisations AutorisationAcces[] @relation("AutorisationsEntreprise")

  @@map("entreprises")
}

model DemandeAcces {
  id                   String        @id @default(cuid())
  nomEntreprise        String
  nomResponsable       String
  email                String
  telephone            String
  secteurActivite      String
  nombreEmployes       String
  message              String?
  statut               StatutDemande @default(EN_ATTENTE)
  dateCreation         DateTime      @default(now())
  dateTraitement       DateTime?
  traitePar            String?
  motifRejet           String?
  motDePasseTemporaire String?
  entrepriseCreeeId    String?       @unique
  entrepriseCreee      Entreprise?   @relation(fields: [entrepriseCreeeId], references: [id])

  @@map("demandes_acces")
}

model Utilisateur {
  id                    String          @id @default(cuid())
  nom                   String
  prenom                String
  email                 String          @unique
  motDePasse            String
  role                  RoleUtilisateur
  entrepriseId          String?
  dateCreation          DateTime        @default(now())
  dateModification      DateTime        @updatedAt
  actif                 Boolean         @default(true)
  doitChangerMotDePasse Boolean         @default(true)

  entreprise                   Entreprise?         @relation(fields: [entrepriseId], references: [id])
  paiementsEffectues           Paiement[]
  pointagesValides             Pointage[]          @relation("PointagesValides")
  autorisationsCommeSuperAdmin AutorisationAcces[] @relation("AutorisationsSuperAdmin")
  autorisationsCommeAdmin      AutorisationAcces[] @relation("AutorisationsAdmin")

  @@map("utilisateurs")
}

model Employe {
  id                   String         @id @default(cuid())
  nomComplet           String
  poste                String
  typeContrat          TypeContrat
  tauxSalaireHoraire   Decimal?
  salaireFixe          Decimal?
  tauxHonoraire        Decimal?
  coordonneesBancaires String?
  telephone            String?
  email                String?
  adresse              String?
  entrepriseId         String
  dateEmbauche         DateTime
  dateCreation         DateTime       @default(now())
  dateModification     DateTime       @updatedAt
  actif                Boolean        @default(true)
  entreprise           Entreprise     @relation(fields: [entrepriseId], references: [id])
  bulletinsPaie        BulletinPaie[]
  paiements            Paiement[]
  pointages            Pointage[]
  qrCode               QRCodeEmploye?

  @@map("employes")
}

model CyclePaie {
  id               String          @id @default(cuid())
  nom              String
  typeCycle        TypeCyclePaie
  dateDebut        DateTime
  dateFin          DateTime
  statut           StatutCyclePaie @default(BROUILLON)
  entrepriseId     String
  dateCreation     DateTime        @default(now())
  dateModification DateTime        @updatedAt
  entreprise       Entreprise      @relation(fields: [entrepriseId], references: [id])
  bulletinsPaie    BulletinPaie[]

  @@map("cycles_paie")
}

model BulletinPaie {
  id                 String             @id @default(cuid())
  employeId          String
  cycleId            String
  entrepriseId       String
  salaireBrut        Decimal
  deductions         Decimal            @default(0)
  salaireNet         Decimal
  joursTravailles    Int?
  heuresTravailleurs Int?
  statut             StatutBulletinPaie @default(EN_ATTENTE)
  dateCreation       DateTime           @default(now())
  dateModification   DateTime           @updatedAt
  employe            Employe            @relation(fields: [employeId], references: [id])
  cyclePaie          CyclePaie          @relation(fields: [cycleId], references: [id])
  entreprise         Entreprise         @relation(fields: [entrepriseId], references: [id])
  paiements          Paiement[]

  @@unique([employeId, cycleId])
  @@map("bulletins_paie")
}

model Paiement {
  id             String       @id @default(cuid())
  bulletinPaieId String
  employeId      String
  entrepriseId   String
  utilisateurId  String
  montant        Decimal
  modePaiement   ModePaiement
  reference      String?
  notes          String?
  datePaiement   DateTime     @default(now())
  dateCreation   DateTime     @default(now())
  bulletinPaie   BulletinPaie @relation(fields: [bulletinPaieId], references: [id])
  employe        Employe      @relation(fields: [employeId], references: [id])
  entreprise     Entreprise   @relation(fields: [entrepriseId], references: [id])
  utilisateur    Utilisateur  @relation(fields: [utilisateurId], references: [id])

  @@map("paiements")
}

model QRCodeEmploye {
  id                  String    @id @default(cuid())
  employeId           String    @unique
  codeQR              String    @unique
  codeSecret          String
  dateGeneration      DateTime  @default(now())
  dateExpiration      DateTime?
  actif               Boolean   @default(true)
  nombreUtilisations  Int       @default(0)
  derniereUtilisation DateTime?
  employe             Employe   @relation(fields: [employeId], references: [id], onDelete: Cascade)

  @@index([codeQR])
  @@index([employeId])
  @@map("qr_codes_employes")
}

model Pointage {
  id              String         @id @default(cuid())
  employeId       String
  entrepriseId    String
  date            DateTime       @db.Date
  heureArrivee    DateTime?
  heureSortie     DateTime?
  typePointage    TypePointage
  statutPresence  StatutPresence @default(PRESENT)
  tempsTraite     DateTime       @default(now())
  adresseIP       String?
  userAgent       String?
  notes           String?
  valideParVigile Boolean        @default(false)
  vigileId        String?
  employe         Employe        @relation(fields: [employeId], references: [id])
  entreprise      Entreprise     @relation(fields: [entrepriseId], references: [id])
  vigile          Utilisateur?   @relation("PointagesValides", fields: [vigileId], references: [id])

  @@unique([employeId, date, typePointage])
  @@index([date])
  @@index([employeId])
  @@index([entrepriseId])
  @@index([statutPresence])
  @@map("pointages")
}

model AutorisationAcces {
  id                String    @id @default(cuid())
  entrepriseId      String
  superAdminId      String
  adminId           String
  dateCreation      DateTime  @default(now())
  dateExpiration    DateTime
  estActif          Boolean   @default(true)
  raisonAcces       String?
  dateDesactivation DateTime?

  entreprise Entreprise  @relation("AutorisationsEntreprise", fields: [entrepriseId], references: [id], onDelete: Cascade)
  superAdmin Utilisateur @relation("AutorisationsSuperAdmin", fields: [superAdminId], references: [id])
  admin      Utilisateur @relation("AutorisationsAdmin", fields: [adminId], references: [id])

  @@index([entrepriseId])
  @@index([superAdminId])
  @@index([adminId])
  @@index([dateExpiration])
  @@index([estActif])
  @@map("autorisations_acces")
}
